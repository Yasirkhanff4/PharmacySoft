# Copy this file to .env.local and fill in the values from:
# Firebase Console > Project settings > Your apps > PharmaCare Web > SDK setup and configuration.
#
# These are Firebase Web app identifiers, not server credentials.
# Never add service-account keys or private credentials to a Vite app.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shared cloud workspace document ID under pharmacies/{pharmacyId}.
VITE_FIREBASE_PHARMACY_ID=main

# Development only: set to 1 to use the local Firebase emulators
# (`firebase emulators:start`) instead of the real project. Ignored by builds.
VITE_USE_FIREBASE_EMULATOR=0

# ---------------------------------------------------------------------------
# Server-only settings for the "Connect with Google" backend (api/).
# These must NEVER be prefixed with VITE_ and must never be committed.
# On Vercel add them under Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Google Cloud OAuth 2.0 Web application client.
# Authorized redirect URIs must include:
#   http://localhost:5173/api/google/callback
#   https://<your-production-domain>/api/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Random 32+ character secret used to seal the HttpOnly session cookie.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OAUTH_SESSION_SECRET=

# Comma-separated list of allowed browser origins (no trailing slash).
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Firebase project that identifies this app's workspace, used to verify that
# the calling device is an active workspace administrator.
FIREBASE_PROJECT_ID=pharmacysoft-ad19a
FIREBASE_WORKSPACE_ID=main

