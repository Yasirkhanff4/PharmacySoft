# Copy this file to .env.local and fill in the values from:
# Firebase Console > Project settings > Your apps > PharmaCare Web > SDK setup and configuration.
#
# These are Firebase Web app identifiers, not server credentials.
# Never add service-account keys or private credentials to a Vite app.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shared cloud workspace document ID under pharmacies/{pharmacyId}.
VITE_FIREBASE_PHARMACY_ID=main

# Development only: set to 1 to use the local Firebase emulators
# (`firebase emulators:start`) instead of the real project. Ignored by builds.
VITE_USE_FIREBASE_EMULATOR=0
